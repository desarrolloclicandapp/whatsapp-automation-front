# Compile only the v1 panel, then reuse the exact recovered production runtime.
ARG PANEL_BASE_IMAGE=waflow-v1-frontend:recovery-794c620-20261018
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .

ARG VITE_API_URL
ARG VITE_INSTALL_APP_URL
ARG VITE_STRIPE_PUBLIC_KEY
ARG VITE_SUPPORT_PHONE
ARG VITE_OFFICIAL_WHATSAPP_API_UI_ENABLED
ARG VITE_OFFICIAL_WHATSAPP_API_ADMIN_BYPASS_ENABLED
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_INSTALL_APP_URL=${VITE_INSTALL_APP_URL}
ENV VITE_STRIPE_PUBLIC_KEY=${VITE_STRIPE_PUBLIC_KEY}
ENV VITE_SUPPORT_PHONE=${VITE_SUPPORT_PHONE}
ENV VITE_OFFICIAL_WHATSAPP_API_UI_ENABLED=${VITE_OFFICIAL_WHATSAPP_API_UI_ENABLED}
ENV VITE_OFFICIAL_WHATSAPP_API_ADMIN_BYPASS_ENABLED=${VITE_OFFICIAL_WHATSAPP_API_ADMIN_BYPASS_ENABLED}
RUN npm run build

FROM ${PANEL_BASE_IMAGE}
COPY --from=builder /app/dist/ /app/dist/
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
